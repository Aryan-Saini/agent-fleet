#!/usr/bin/env bash
# fleet-link: give every agent harness on this machine the same rules and skills.
#
#   fleet link            wire rules + skills, report what changed
#   fleet link --quiet    same, silent unless something fails (fleet sync runs this)
#
# Rules, one source each:
#   rules/CLAUDE.md -> ~/.claude/CLAUDE.md                Claude Code
#   rules/AGENTS.md -> ~/.codex/AGENTS.md                 Codex, and opencode by reference
#   rules/AGENTS.md -> ~/.cursor/rules/fleet-global.mdc   Cursor (generated: it wants .mdc)
#
# Skills come from skills/ (every machine), skills-<role>/ (controller or worker only) and
# skills-local/ (yours, never touched by kit upgrades). Each SKILL.md's frontmatter decides
# where it lands:
#   harness: [claude, codex, cursor, opencode]   which harness dirs get a symlink
#   platform: [darwin, linux]                    skipped on any other OS
# Where a skill physically is decides who loads it, so a skill that must stay out of a harness
# is simply never linked there. Stale links that point into this repo are removed.
set -uo pipefail
self="$0"; while [ -L "$self" ]; do l="$(readlink "$self")"; case $l in /*) self=$l ;; *) self="$(dirname "$self")/$l" ;; esac; done
# shellcheck source=fleet-lib.sh
. "$(dirname "$self")/fleet-lib.sh"

QUIET=0; [ "${1:-}" = --quiet ] && QUIET=1
say() { [ "$QUIET" = 1 ] || printf '%s\n' "$*"; }

# link SRC DEST: symlink, backing up a real file once so nothing hand-written is lost
link() {
  local src="$1" dest="$2"
  [ -e "$src" ] || return 0
  mkdir -p "$(dirname "$dest")"
  if [ -L "$dest" ]; then
    [ "$(readlink "$dest")" = "$src" ] && return 0
    rm -f "$dest"
  elif [ -e "$dest" ]; then
    mv "$dest" "$dest.pre-fleet" && say "backed up $dest -> $dest.pre-fleet"
  fi
  ln -s "$src" "$dest" && say "linked $dest"
}

# ---- rules
link "$FLEET_HOME/rules/CLAUDE.md" "$HOME/.claude/CLAUDE.md"
link "$FLEET_HOME/rules/AGENTS.md" "$HOME/.codex/AGENTS.md"
if [ -d "$HOME/.cursor" ] && [ -f "$FLEET_HOME/rules/AGENTS.md" ]; then
  mkdir -p "$HOME/.cursor/rules"
  out="$HOME/.cursor/rules/fleet-global.mdc"
  new="$(printf -- '---\nalwaysApply: true\ndescription: Global rules (generated from fleet rules/AGENTS.md)\n---\n\n<!-- GENERATED by fleet-link. Edit rules/AGENTS.md in your fleet repo instead. -->\n\n'; cat "$FLEET_HOME/rules/AGENTS.md")"
  [ "$(cat "$out" 2>/dev/null)" = "$new" ] || { printf '%s\n' "$new" > "$out"; say "wrote $out"; }
fi
oc="$HOME/.config/opencode"
if [ -d "$oc" ] && ! grep -qs 'AGENTS.md' "$oc"/opencode.json*; then
  say "opencode: add \"instructions\": [\"~/.codex/AGENTS.md\"] to $oc/opencode.jsonc (see docs/harnesses.md)"
fi

# ---- skills
# frontmatter LIST-KEY FILE prints the [a, b] list for KEY, space separated, or nothing
fm_list() { awk -v k="$1" 'NR==1&&$0!="---"{exit} NR>1&&$0=="---"{exit} $0~"^[ \t]*"k":"{sub(/^[^[]*\[/,"");sub(/\].*/,"");gsub(/,/," ");print}' "$2"; }

declare -a wanted=()
for dir in "$FLEET_HOME/skills" "$FLEET_HOME/skills-$FLEET_ROLE" "$FLEET_HOME/skills-local"; do
  for s in "$dir"/*/SKILL.md; do
    [ -f "$s" ] || continue
    skill="$(dirname "$s")"; name="$(basename "$skill")"
    # Precedence, most specific wins: skills-local/ over skills-<role>/ over skills/
    case "$dir" in
      "$FLEET_HOME/skills") [ -f "$FLEET_HOME/skills-$FLEET_ROLE/$name/SKILL.md" ] || [ -f "$FLEET_HOME/skills-local/$name/SKILL.md" ] && continue ;;
      "$FLEET_HOME/skills-$FLEET_ROLE") [ -f "$FLEET_HOME/skills-local/$name/SKILL.md" ] && continue ;;
    esac
    platforms="$(fm_list platform "$s")"
    if [ -n "$platforms" ] && [[ " $platforms " != *" $FLEET_OS "* ]]; then continue; fi
    harness="$(fm_list harness "$s")"; [ -z "$harness" ] && harness="claude codex cursor opencode"
    targets=()
    [[ " $harness " == *" claude "* ]] && targets+=("$HOME/.claude/skills")
    [[ " $harness " == *" codex "* ]] && targets+=("$HOME/.codex/skills")
    [[ " $harness " == *" cursor "* || " $harness " == *" opencode "* ]] && targets+=("$HOME/.agents/skills")
    for t in ${targets[@]+"${targets[@]}"}; do link "$skill" "$t/$name"; wanted+=("$t/$name"); done
  done
done

# Remove links into this repo that no longer qualify (deleted skill, role or OS changed).
for t in "$HOME/.claude/skills" "$HOME/.codex/skills" "$HOME/.agents/skills"; do
  for l in "$t"/*; do
    [ -L "$l" ] || continue
    case "$(readlink "$l")" in "$FLEET_HOME"/*) ;; *) continue ;; esac
    keep=0; for w in ${wanted[@]+"${wanted[@]}"}; do [ "$w" = "$l" ] && keep=1 && break; done
    [ "$keep" = 0 ] && rm -f "$l" && say "unlinked $l"
  done
done
say "rules and skills linked for $FLEET_NAME ($FLEET_ROLE, $FLEET_OS)"
