#!/usr/bin/env bash
# fleet-secrets: API keys live on the controller and are pushed to other machines over ssh.
#
#   fleet secrets check              which keys are set here (names only, never values)
#   fleet secrets push <machine>...  copy this machine's keys to each machine, mode 600
#
# What moves: ~/.config/agent-secrets.env, every file in ~/.config/fleet/secrets/ (service
# account JSON and the like), and ~/.postplan/config.json. Static keys only. OAuth logins
# (claude, codex, cursor-agent, gh, t3, convex) are never copied: their tokens rotate, and two
# machines sharing one end up logging each other out. Log in on each machine instead.
set -euo pipefail
self="$0"; while [ -L "$self" ]; do l="$(readlink "$self")"; case $l in /*) self=$l ;; *) self="$(dirname "$self")/$l" ;; esac; done
# shellcheck source=fleet-lib.sh
. "$(dirname "$self")/fleet-lib.sh"

ENVF="$HOME/.config/agent-secrets.env"
DIR="$FLEET_CONFIG_DIR/secrets"
# Paths relative to $HOME, so they land in the same place on a machine with a different home.
files() {
  [ -f "$ENVF" ] && echo ".config/agent-secrets.env"
  [ -f "$HOME/.postplan/config.json" ] && echo ".postplan/config.json"
  if [ -d "$DIR" ]; then
    find "$DIR" -maxdepth 1 -type f ! -name '.*' | sed "s|^$HOME/||"
  fi
  return 0
}

case "${1:-check}" in
check)
  if [ -f "$ENVF" ]; then
    perm="$(stat -f %Lp "$ENVF" 2>/dev/null || stat -c %a "$ENVF")"
    [ "$perm" = 600 ] || echo "WARNING: $ENVF is mode $perm, run: chmod 600 $ENVF"
    awk -F= '/^[[:space:]]*(export[[:space:]]+)?[A-Z][A-Z0-9_]*=/ {
      v = substr($0, index($0, "=") + 1); gsub(/["\047[:space:]]/, "", v)
      k = $1; sub(/^[[:space:]]*(export[[:space:]]+)?/, "", k)
      printf "%-34s %s\n", k, (v == "" ? "MISSING" : "set") }' "$ENVF"
  else
    echo "no $ENVF yet (copy templates/agent-secrets.env there, chmod 600)"
  fi
  [ -f "$HOME/.postplan/config.json" ] && printf '%-34s %s\n' "postdraft (~/.postplan)" set
  if [ -d "$DIR" ]; then
    for f in "$DIR"/*; do [ -f "$f" ] && printf '%-34s %s\n' "secrets/$(basename "$f")" file; done
  fi
  exit 0 ;;
push)
  shift; [ $# -gt 0 ] || fleet_die "usage: fleet secrets push <machine>..."
  [ "$FLEET_ROLE" = controller ] || fleet_die "push from the controller, the one place keys are edited"
  list="$(files)"; [ -n "$list" ] || fleet_die "nothing to push"
  for m in "$@"; do
    # tar keeps modes; umask 077 means nothing is ever readable by others, even mid-write.
    # shellcheck disable=SC2086
    (cd "$HOME" && tar cf - $list) | ssh "$m" 'umask 077 && cd ~ && tar xf - && chmod 600 '"$(tr '\n' ' ' <<<"$list")" ||
      fleet_die "push to $m failed"
    echo "$m: $(echo "$list" | wc -l | tr -d ' ') file(s) pushed"
  done
  echo "restart long-running services there (T3, timers) so they pick the keys up"
  ;;
-h|--help|help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' ;;
*) fleet_die "unknown subcommand '$1' (check | push)" ;;
esac
