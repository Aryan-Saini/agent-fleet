# One dev server per instance: devserver@<name>. Managed by worker-expose, never by hand.
[Unit]
Description=Dev server %i (worker-expose, HTTPS over Tailscale)
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/bin/devserver %i
Restart=always
RestartSec=5
TimeoutStopSec=20
# Dev servers run arbitrary npm code. This stops it calling sudo or setuid binaries directly. It
# does not stop it asking the user's systemd manager for another unit, so it is not isolation:
# for untrusted code, run the unit as a separate account with no sudo.
NoNewPrivileges=yes

[Install]
WantedBy=default.target
