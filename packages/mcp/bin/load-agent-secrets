#!/bin/sh
# load-agent-secrets: publish ~/.config/agent-secrets.env to processes that read no shell profile.
#
#   macOS  launchctl setenv NAME VALUE    -> every app launched from the Dock, Spotlight or an IDE
#   Linux  systemctl --user set-environment -> every systemd user service started afterwards
#
# Why. Keys sourced from ~/.zshenv reach shells, including `ssh <worker> '<agent>'`. They do not
# reach a harness launched from the Dock (launchd's environment) or a systemd service such as the
# T3 Code backend. There "Bearer ${LINEAR_API_KEY}" expands to "Bearer " and every keyed MCP
# server answers invalid_token at the same moment.
#
# Run it at login: a LaunchAgent with RunAtLoad (packages/mcp/units/fleet.agent-secrets.plist), or the
# agent-secrets.service user unit ordered before your agent services. Safe to re-run after
# rotating a key; on Linux, restart long-running services afterwards, since set-environment only
# reaches units started after it.
#
# Tradeoff: these become readable by every process in that session or service manager. That is
# the same reach a shell export has, but keep anything that should not have it out of the file.
set -eu

SECRETS="${AGENT_SECRETS_FILE:-$HOME/.config/agent-secrets.env}"
[ -r "$SECRETS" ] || { echo "load-agent-secrets: $SECRETS not readable" >&2; exit 1; }

case "$(uname -s)" in
  Darwin) publish() { launchctl setenv "$1" "$2"; } ;;
  Linux)  publish() { systemctl --user set-environment "$1=$2"; } ;;
  *) echo "load-agent-secrets: no recipe for $(uname -s)" >&2; exit 1 ;;
esac

n=0
# Only plain `export NAME=VALUE` lines. Anything else is ignored, not evaluated, so the file never
# becomes a place that runs code at login.
while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in export\ *=*) ;; *) continue ;; esac
  kv="${line#export }"
  name="${kv%%=*}"
  value="${kv#*=}"
  case "$name" in *[!A-Za-z0-9_]*|'') continue ;; esac
  case "$value" in
    \"*\") value="${value#\"}"; value="${value%\"}" ;;
    \'*\') value="${value#\'}"; value="${value%\'}" ;;
  esac
  publish "$name" "$value"
  n=$((n + 1))
done < "$SECRETS"

echo "load-agent-secrets: published $n key(s) at $(date '+%Y-%m-%dT%H:%M:%S')"
