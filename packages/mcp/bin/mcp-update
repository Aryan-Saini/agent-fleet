#!/bin/sh
# mcp-update: keep the two keyless global MCP servers current, on this machine, on its own.
# Daily on workers (units/mcp-update.timer), so a worker never depends on the controller being
# awake to have working servers. Low risk by design: two keyless node CLIs, no service to restart,
# nothing at boot depends on them. A failure means "stayed on the version that already worked",
# so it never rolls back and never alerts.
set -u
PREFIX="${MCP_GLOBAL_PREFIX:-$HOME/.npm-global}"
PKGS="chrome-devtools-mcp @playwright/mcp"
export PATH="$PREFIX/bin:$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"
log() { echo "$(date '+%Y-%m-%dT%H:%M:%S') mcp-update: $*"; }

versions() {
  for pkg in $PKGS; do
    printf ' %s=%s' "$pkg" "$(node -p "require('$PREFIX/lib/node_modules/$pkg/package.json').version" 2>/dev/null || echo none)"
  done
}

before=$(versions)
# shellcheck disable=SC2046
if ! npm install -g --prefix "$PREFIX" $(for p in $PKGS; do printf '%s@latest ' "$p"; done) >/dev/null 2>&1; then
  log "npm install failed (offline?), keeping$before"
  exit 0
fi
after=$(versions)

# The shim is what every harness runs. Prove it still starts with a bare PATH, the way a
# Dock-launched harness or a service would call it.
if env -i HOME="$HOME" PATH=/usr/bin:/bin "$HOME/.local/bin/mcp-server-launch" playwright --help >/dev/null 2>&1; then
  shim=ok
else
  shim=BROKEN
fi
if [ "$before" = "$after" ]; then log "no change:$after (shim $shim)"; else log "updated:$before ->$after (shim $shim)"; fi
