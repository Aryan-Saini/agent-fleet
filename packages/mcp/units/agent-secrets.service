# Publish agent MCP keys into the systemd user manager, before anything that spawns agents.
# set-environment only reaches units started after it, hence Before=.
[Unit]
Description=Publish agent keys into the systemd user environment
Before=t3code.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=%h/.local/bin/load-agent-secrets

[Install]
WantedBy=default.target
