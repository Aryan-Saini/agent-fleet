<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- install.sh replaces __HOME__ and copies this to ~/Library/LaunchAgents/.
     At login, publish agent keys to apps launched from the Dock, Spotlight or an IDE. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>fleet.agent-secrets</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/load-agent-secrets</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__HOME__/.local/state/fleet/logs/agent-secrets.out</string>
  <key>StandardErrorPath</key><string>__HOME__/.local/state/fleet/logs/agent-secrets.out</string>
</dict>
</plist>
