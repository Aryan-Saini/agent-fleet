#!/usr/bin/env bash
# repo-sync: keep "no PR, just sync" repos identical between machines. packages/settings-sync.
#
#   repo-sync            sync the peer's half first (over ssh), then this machine's repos
#   repo-sync --local    this machine only (what the peer step runs)
#
# Repos come from ~/.config/fleet/repo-sync.list, one per line, per machine (paths differ):
#   full  ~/notes            commit every local edit, rebase on origin/main, push
#   pull  ~/dev/site         fast-forward a clean main only, never commit (repos that deploy
#                            from main, where auto-committing would ship half-done work)
#
# REPO_SYNC_PEER (an ssh alias, in machine.env) makes the run sync that machine's half first, so
# its edits are pushed before this one rebases. Run it from one machine on a timer (every 15 min)
# and the other gets synced too; an asleep peer is reported and skipped.
#
# Files over REPO_SYNC_MAX_MB (default 5) that git does not track yet are added to the repo's
# .git/info/exclude instead of being committed, so a dropped video never lands in history.
# Commits use each repo's own git identity.
set -uo pipefail
self="$0"; while [ -L "$self" ]; do l="$(readlink "$self")"; case $l in /*) self=$l ;; *) self="$(dirname "$self")/$l" ;; esac; done
# shellcheck source=/dev/null
[ -f "$(dirname "$self")/../../../bin/fleet-lib.sh" ] && . "$(dirname "$self")/../../../bin/fleet-lib.sh"

LIST="${XDG_CONFIG_HOME:-$HOME/.config}/fleet/repo-sync.list"
MAX_MB="${REPO_SYNC_MAX_MB:-5}"
LABEL="${FLEET_NAME:-$(hostname -s 2>/dev/null || uname -n)}"
local_only=0; [ "${1:-}" = --local ] && local_only=1

if [ "$local_only" -eq 0 ] && [ -n "${REPO_SYNC_PEER:-}" ]; then
  # echo in this shell, not through a pipe: a child's output is filed under its own pid and
  # `journalctl -u` would hide it from the unit's log.
  peer_out=$(ssh -o BatchMode=yes -o ConnectTimeout=10 "$REPO_SYNC_PEER" 'repo-sync --local' 2>&1)
  peer_rc=$?
  while IFS= read -r line; do echo "[$REPO_SYNC_PEER] $line"; done <<< "${peer_out:-<no output>}"
  [ "$peer_rc" -ne 0 ] && echo "[$REPO_SYNC_PEER] exit $peer_rc: asleep or a repo failed; continuing here"
fi

[ -f "$LIST" ] || { echo "no $LIST; nothing to sync"; exit 0; }

# Exclude untracked files over the size limit, locally, before anything is staged.
guard_large() {
  local f size
  git ls-files -z --others --exclude-standard | while IFS= read -r -d '' f; do
    size=$(wc -c < "$f" 2>/dev/null || echo 0)
    if [ "$size" -gt $((MAX_MB * 1024 * 1024)) ]; then
      printf '/%s\n' "$f" >> .git/info/exclude
      echo "excluded $f ($((size / 1024 / 1024)) MB > $MAX_MB MB)"
    fi
  done
}

sync_full() {
  [ "$(git branch --show-current)" = main ] || { echo "not on main, skipped"; return 1; }
  guard_large
  git add -A
  if ! git diff --cached --quiet; then
    local count; count=$(git diff --cached --name-only | wc -l | tr -d ' ')
    git commit -q -m "sync: $LABEL ($count file(s))" || { echo "commit failed"; return 1; }
    echo "committed $count change(s)"
  fi
  git fetch -q origin || { echo "fetch failed (offline?)"; return 1; }
  if ! git rebase -q --autostash origin/main; then
    git rebase --abort 2>/dev/null
    echo "REBASE CONFLICT: resolve by hand in $PWD"; return 1
  fi
  if [ -n "$(git log --oneline origin/main..HEAD)" ]; then
    git push -q origin main || { echo "push failed"; return 1; }
    echo "pushed"
  else
    echo "up to date"
  fi
}

sync_pull() {
  git fetch -q origin || { echo "fetch failed (offline?)"; return 1; }
  local branch behind
  branch=$(git branch --show-current)
  behind=$(git rev-list --count HEAD..origin/main)
  if [ "$branch" != main ]; then
    echo "on ${branch:-detached HEAD}, left alone (main is $behind ahead of it)"
  elif [ "$behind" -eq 0 ]; then
    echo "up to date"
  elif git merge -q --ff-only origin/main 2>/dev/null; then
    echo "fast-forwarded $behind commit(s)"
  else
    echo "BLOCKED: local commits or edits stop the fast-forward ($behind behind), left alone"
  fi
}

failed=0
while read -r mode repo _; do
  case "$mode" in full|pull) ;; ''|\#*) continue ;; *) echo "bad line in $LIST: $mode $repo"; failed=1; continue ;; esac
  repo="${repo/#\~/$HOME}"
  # Subshell per repo: the cd and any failure stay contained.
  out=$( { cd "$repo" && [ -e .git ] && "sync_$mode"; } 2>&1 ) || failed=1
  while IFS= read -r line; do echo "[$(basename "$repo")] $line"; done <<< "${out:-missing or not a git repo}"
done < "$LIST"
exit $failed
