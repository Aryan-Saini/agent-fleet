# fleet.env: shared settings, committed, identical on every machine.
# Machine-specific values and anything secret go in ~/.config/fleet/machine.env instead.
# Never put a token, password or key in this file: this repo is pushed.

# Extra checkouts workers keep in step with the controller, as "path|clone-url" pairs.
# This fleet repo is always synced; list others here if your agent config lives in its own repos.
# FLEET_SYNC_REPOS="~/.claude|git@github.com:you/claude-config.git ~/.codex|git@github.com:you/codex-config.git"
FLEET_SYNC_REPOS=""

# Packages may read their settings from here too. See each packages/<name>/README.md.
# T3_PORT=3773
