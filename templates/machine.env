# ~/.config/fleet/machine.env: this machine only. Never committed, mode 600.
# install.sh writes the first four lines. Everything here overrides fleet.env.

FLEET_NAME=worker              # this machine's name in computers.md and its ssh alias elsewhere
FLEET_ROLE=worker              # controller | worker
FLEET_PACKAGES="tailscale drop-folder"   # folders under packages/ enabled on this machine
FLEET_CONTROLLER=              # workers: ssh alias of the controller (alerts, rejoin checks)

# Optional: phone push for alerts through ntfy. Pick a long random topic; anyone who knows it
# can read your alerts. Generate one with: openssl rand -hex 16
FLEET_NTFY_TOPIC=
# FLEET_NTFY_SERVER=https://ntfy.sh

# FLEET_DROP=$HOME/drop        # override only if your drop folder lives elsewhere

# T3 Code channel for packages/t3-remote: stable | nightly
# T3_CHANNEL=stable
